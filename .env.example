DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_URL=
JWT_SECRET=
JWT_EXPIRATION=900000 ## em milissegundos (ex: 900000 = 15 minutos)
REFRESH_TOKEN_EXPIRATION=604800000 ## em milissegundos (ex: 604800000 = 7 dias)
COOKIE_SECURE=false ## true em producao HTTPS
COOKIE_SAME_SITE=Lax ## Lax para mesmo domínio / localhost, None para cross-origin com HTTPS
ALLOWED_ORIGINS= ##links do frontend, separados por vírgula ex: http://localhost:5173,http://localhost:4173
SPRING_DATASOURCE_URL= ##se for rodar no docker deixar, se for rodar na ide, apagar
CLOUDINARY_URL= ##formato: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
RESEND_API_KEY=
PASSWORD_RESET_PEPPER=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ACCOUNT=5 ## tentativas por minuto por conta de e-mail (anti-brute-force)
RATE_LIMIT_LOGIN_IP=150 ## requisições por minuto por IP (anti-DDoS, generoso para NAT de escolas)
RATE_LIMIT_REFRESH_TOKEN=15 ## rotações por minuto por token individual
RATE_LIMIT_REFRESH_IP=300 ## refreshes por minuto por IP da rede escolar
RATE_LIMIT_REGISTER_IP=60
RATE_LIMIT_PASSWORD_RESET_IP=30
